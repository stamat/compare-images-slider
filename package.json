{
  "name": "compare-images-slider",
  "version": "3.0.0",
  "description": "A dependency-free before/after comparison slider - two images, two videos, or whatever else you put in the markup.",
  "type": "module",
  "main": "src/scripts/compare-images-slider.js",
  "style": "src/styles/index.scss",
  "customElements": "dist/custom-elements.json",
  "exports": {
    ".": "./src/scripts/compare-images-slider.js",
    "./style.scss": "./src/styles/index.scss",
    "./style.css": "./dist/compare-images-slider.css",
    "./theme.scss": "./src/styles/theme.scss",
    "./theme.css": "./dist/compare-images-slider-theme.css",
    "./custom-elements.json": "./dist/custom-elements.json",
    "./styles/*": "./src/styles/*",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/scripts",
    "src/styles/index.scss",
    "src/styles/theme.scss",
    "CHANGELOG.md"
  ],
  "homepage": "https://stamat.github.io/compare-images-slider/",
  "repository": {
    "type": "git",
    "url": "https://github.com/stamat/compare-images-slider.git"
  },
  "keywords": [
    "compare",
    "images",
    "slider",
    "javascript",
    "esm"
  ],
  "author": "Nikola Stamatovic <@stamat>",
  "contributors": [],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/stamat/compare-images-slider/issues"
  },
  "scripts": {
    "dev": "poops",
    "build": "poops -b",
    "test": "node --test",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@eslint/js": "^10.0.1",
    "code-preview-element": "^3.0.3",
    "eslint": "^10.7.0",
    "poops": "^3.0.0",
    "poops-docs-theme": "^4.5.0"
  }
}
