{
  "scripts": [{
    "in": "src/scripts/iife.js",
    "out": "dist/compare-images-slider.js",
    "options": {
      "sourcemap": true,
      "minify": true,
      "justMinified": false,
      "format": "iife"
    }
  },
  {
    "in": "node_modules/poops-docs-theme/src/prose.ts",
    "out": "js/prose.js",
    "options": {
      "minify": true,
      "justMinified": true,
      "format": "iife"
    }
  }],
  "styles": [{
    "in": "src/styles/index.scss",
    "out": "dist/compare-images-slider.css",
    "options": {
      "sourcemap": true,
      "minify": true,
      "justMinified": false
    }
  },
  {
    "in": "src/styles/prose.scss",
    "out": "css/prose.css",
    "options": {
      "minify": true,
      "justMinified": true
    }
  }],
  "markup": {
    "in": "src/markup",
    "out": ".",
    "options": {
      "site": {
        "title": "Compare Images Slider",
        "brand": "compare-images-slider",
        "brandMark": "🖼️",
        "description": "A simple slider for comparing two images visually.",
        "lang": "en",
        "url": "https://stamat.github.io/compare-images-slider",
        "repo": "https://github.com/stamat/compare-images-slider",
        "branch": "main",
        "links": [
          { "title": "npm", "url": "https://www.npmjs.com/package/compare-images-slider" }
        ],
        "theme": "light"
      }
    }
  },
  "banner": "/* {{ name }} v{{ version }} | {{ homepage }} | {{ license }} License */",
  "serve" : {
    "port": 4040
  },
  "livereload": true,
  "watch": [
    "src"
  ],
  "includePaths": [
    "node_modules"
  ]
}
