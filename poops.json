{
  "scripts": [{
    "in": "src/scripts/iife.js",
    "out": "dist/compare-images-slider.js",
    "options": {
      "sourcemap": true,
      "minify": true,
      "justMinified": false,
      "format": "iife"
    }
  },
  {
    "in": "node_modules/poops-docs-theme/src/prose.ts",
    "out": "js/prose.js",
    "options": {
      "minify": true,
      "justMinified": true,
      "format": "iife"
    }
  }],
  "styles": [{
    "in": "src/styles/index.scss",
    "out": "dist/compare-images-slider.css",
    "options": {
      "sourcemap": true,
      "minify": true,
      "justMinified": false
    }
  },
  {
    "in": "src/styles/theme.scss",
    "out": "dist/compare-images-slider-theme.css",
    "options": {
      "sourcemap": true,
      "minify": true,
      "justMinified": false
    }
  },
  {
    "in": "src/styles/prose.scss",
    "out": "css/prose.css",
    "options": {
      "minify": true,
      "justMinified": true
    }
  }],
  "markup": {
    "in": "src/markup",
    "out": ".",
    "options": {
      "sitemap": "sitemap.xml",
      "robots": "robots.txt",
      "llms": {
        "out": "llms.txt",
        "full": true
      },
      "site": {
        "title": "Compare Images Slider",
        "brand": "compare-images-slider",
        "brandMark": "🖼️",
        "description": "A dependency-free before/after image comparison slider \u2014 a compare-images-slider custom element or a class you instantiate, with no shadow DOM to fight.",
        "image": "img/og.jpg",
        "lang": "en",
        "url": "https://stamat.github.io/compare-images-slider/",
        "repo": "https://github.com/stamat/compare-images-slider",
        "branch": "main",
        "iconLinks": [
          { "title": "npm", "url": "https://www.npmjs.com/package/compare-images-slider", "icon": "npm" }
        ],
        "footer": "<a href=\"https://stamat.github.io/compare-images-slider/\" target=\"_blank\" rel=\"noopener\">compare-images-slider</a> \u2014 MIT licensed. Built with <span aria-hidden=\"true\">\ud83d\udca9</span> <a href=\"https://github.com/stamat/poops\" target=\"_blank\" rel=\"noopener\">Poops</a>, <a href=\"https://github.com/stamat/poops-docs-theme\" target=\"_blank\" rel=\"noopener\">poops-docs-theme</a> and <a href=\"https://github.com/stamat/code-preview-element\" target=\"_blank\" rel=\"noopener\">code-preview-element</a>."
      }
    }
  },
  "copy": [
    {
      "in": [
        "node_modules/code-preview-element/dist/code-preview-hljs.min.js",
        "node_modules/code-preview-element/dist/code-preview-options.min.js"
      ],
      "out": "js"
    },
    {
      "in": "node_modules/code-preview-element/dist/code-preview.min.css",
      "out": "css"
    }
  ],
  "exec": {
    "scripts": "npx cem analyze --globs src/scripts/compare-images-slider.js --outdir dist"
  },
  "banner": "/* {{ name }} v{{ version }} | {{ homepage }} | {{ license }} License */",
  "serve" : {
    "port": 4040
  },
  "livereload": true,
  "watch": [
    "src"
  ],
  "includePaths": [
    "node_modules"
  ]
}
