              "name": "windowMs",
              "default": "80",
              "description": "Look-back window in milliseconds.",
              "optional": true,
              "type": {
                "text": "number"
              }
            }
          ],
          "description": "Compute a flick velocity (percent per millisecond) from recent pointer samples.\n\nThe velocity is measured over a time window rather than a single frame delta.\nA single-frame delta spikes on quick flicks - one large jump between the last\ntwo move events makes inertia shoot straight to an extreme. Averaging the\ndisplacement over the last `windowMs` of movement smooths those spikes out.",
          "return": {
            "type": {
              "text": "number"
            }
          }
        },
        {
          "kind": "function",
          "name": "capVelocity",
          "parameters": [
            {
              "name": "velocity",
              "type": {
                "text": "number"
              }
            },
            {
              "name": "max",
              "description": "Maximum absolute velocity.",
              "type": {
                "text": "number"
              }
            }
          ],
          "description": "Cap the magnitude of a velocity while preserving its sign.\nPrevents a hard flick from carrying the handle to an extreme every time.",
          "return": {
            "type": {
              "text": "number"
            }
          }
        },
        {
