        {
          "kind": "class",
          "description": "`<compare-images-slider>` custom element. Uses light DOM (no shadow root) so\nthe images, frame and handle stay fully stylable by the page author.\n\nEvery attribute below is also readable as `data-*` or passed to the\n`CompareImagesSlider` constructor in its camelCase form — `readOptionsFromElement`\nis what reconciles the three, and `data-*` wins where both are written.",
          "name": "CompareImagesSliderElement",
          "cssProperties": [
            {
              "type": {
                "text": "<length-percentage>"
              },
              "description": "Where the reveal edge sits before the script has run. Declared on `:root`, so it is the pre-upgrade paint and not the live position.",
              "name": "--compare-images-slider-initial-position",
              "default": "50%"
            },
            {
              "type": {
                "text": "<color>"
              },
              "description": "Handle fill.",
              "name": "--compare-images-slider-handle-bg",
              "default": "#fff"
            },
            {
              "type": {
                "text": "<color>"
              },
              "description": "Handle foreground — the knob's arrows.",
              "name": "--compare-images-slider-handle-fg",
              "default": "#000"
            },
            {
              "type": {
                "text": "<length>"
              },
              "description": "Handle diameter.",
              "name": "--compare-images-slider-handle-size",
              "default": "42px"
            },
            {
              "type": {
                "text": "<length>"
              },
              "description": "Handle glyph size, for a handle drawn with text rather than the svg knob.",
              "name": "--compare-images-slider-handle-font-size",
              "default": "28px"
            }
          ],
          "attributes": [
            {
              "type": {
                "text": "boolean"
              },
              "description": "Keep gliding after a flick.",
              "name": "inertia",
              "default": "false"
            },
            {
              "type": {
                "text": "boolean"
              },
              "description": "Bounce off the edges while under inertia. Does nothing without `inertia`.",
              "name": "bounce",
              "default": "false"
            },
            {
              "type": {
                "text": "boolean"
              },
              "description": "Split top and bottom instead of left and right.",
              "name": "vertical",
              "default": "false"
            },
            {
              "type": {
                "text": "boolean"
              },
              "description": "Only the handle starts a drag. Off, a press anywhere on the images does.",
              "name": "only-handle",
              "default": "true"
            },
            {
              "type": {
                "text": "number"
              },
              "description": "Inertia decay per frame, 0-1. Applied frame-rate independently, so the feel holds across displays.",
              "name": "friction",
              "default": "0.9"
            },
            {
              "type": {
                "text": "number"
              },
              "description": "Energy kept on a bounce, 0-1.",
              "name": "bounce-factor",
              "default": "0.1"
            },
